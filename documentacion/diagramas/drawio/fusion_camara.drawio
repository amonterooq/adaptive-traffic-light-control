        </mxCell>
        <mxCell id="v2i" value="Avisos V2I&#10;Fracción de coches y&#10;motos&#10;Distancia, velocidad e&#10;instante" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f2ec;strokeColor=#8aa99d;fontColor=#23473e;fontSize=11.6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="335" y="85" width="230" height="80" />
        </mxCell>
        <mxCell id="e2" value="Sensores del cruce&#10;Colas E2 y peatones&#10;Disponibles sin V2I" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8eedc;strokeColor=#8aa99d;fontColor=#23473e;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="645" y="85" width="230" height="80" />
        </mxCell>
        <mxCell id="fusion" value="Fusión por identificador&#10;Una aproximación por vehículo&#10;ETA con velocidad observada" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f2ec;strokeColor=#8aa99d;fontColor=#23473e;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="255" width="265" height="75" />
