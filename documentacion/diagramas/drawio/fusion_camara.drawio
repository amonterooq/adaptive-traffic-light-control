        <mxCell id="cam" value="Cámara emulada&#10;Tipo, posición y velocidad&#10;Con omisiones&#10;configurables" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f2ec;strokeColor=#8aa99d;fontColor=#23473e;fontSize=15.0;" vertex="1" parent="1">
