        <mxCell id="control" value="Control local&#10;Colas y próximas llegadas&#10;Fases y despeje peatonal" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3f5f1;strokeColor=#8aa99d;fontColor=#23473e;fontSize=16;" vertex="1" parent="1">
